# Docker Compose application binding. Keep 127.0.0.1 when a host-level
# Cloudflare Tunnel or reverse proxy is the only public entry point.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# PostgreSQL container credentials. Use a long, unique password. If the
# password contains URI-reserved characters, percent-encode it in DATABASE_URL.
POSTGRES_DB=weightpilot
POSTGRES_USER=weightpilot
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://weightpilot:replace-with-a-long-random-password@db:5432/weightpilot

# Better Auth. Generate a secret with at least 32 random bytes. For local
# Docker, use localhost below. In production set both URLs to
# https://weightpilot.uk (and PUBLIC_APP_URL must be a public HTTPS origin).
# Invitation links use PUBLIC_APP_URL; auth callbacks use BETTER_AUTH_URL.
# Comma-separate any additional trusted origins.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000
# Leave blank for local development; set to https://weightpilot.uk in production.
PUBLIC_APP_URL=
BETTER_AUTH_TRUSTED_ORIGINS=

# Enable only when the app origin is reachable exclusively through a trusted
# Cloudflare Tunnel or reverse proxy that overwrites forwarded client headers.
# For direct local HTTP Docker access, leave this false. WeightPilot assigns
# that loopback-only deployment a local rate-limit bucket automatically.
AUTH_TRUST_PROXY_HEADERS=true

# Resend authentication email delivery. Empty values keep builds working, but
# verification, password-reset and invitation messages will not be delivered at runtime.
RESEND_API_KEY=re_example
EMAIL_FROM=WeightPilot <account@example.com>
# Signing secret for POST /api/webhooks/resend. Subscribe the webhook to
# delivered, failed, bounced, suppressed and complained email events.
RESEND_WEBHOOK_SECRET=whsec_replace-with-resend-signing-secret

# One-time initial administrator bootstrap. Do not keep ADMIN_PASSWORD in the
# long-lived production .env; pass it through a temporary, permission-restricted
# env file and remove that file immediately after bootstrapping.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=WeightPilot Administrator
ADMIN_PASSWORD=replace-with-a-long-unique-passphrase
ADMIN_PREFERRED_LANGUAGE=en

NEXT_TELEMETRY_DISABLED=1
