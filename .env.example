# Docker Compose application binding. Keep 127.0.0.1 when a host-level
# Cloudflare Tunnel or reverse proxy is the only public entry point.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# PostgreSQL container credentials. Use a long, unique password. If the
# password contains URI-reserved characters, percent-encode it in DATABASE_URL.
POSTGRES_DB=weightpilot
POSTGRES_USER=weightpilot
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://weightpilot:replace-with-a-long-random-password@db:5432/weightpilot

# Better Auth. Generate a secret with at least 32 random bytes and set the
# canonical public HTTPS origin. Comma-separate any additional trusted origins.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=https://weightpilot.example.com
BETTER_AUTH_TRUSTED_ORIGINS=

# Enable only when the app origin is reachable exclusively through a trusted
# Cloudflare Tunnel or reverse proxy that overwrites forwarded client headers.
AUTH_TRUST_PROXY_HEADERS=true

# Resend authentication email delivery. Empty values keep builds working, but
# verification and password-reset messages will not be delivered at runtime.
RESEND_API_KEY=re_example
EMAIL_FROM=WeightPilot <account@example.com>

# One-time initial administrator bootstrap. Do not keep ADMIN_PASSWORD in the
# long-lived production .env; pass it through a temporary, permission-restricted
# env file and remove that file immediately after bootstrapping.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=WeightPilot Administrator
ADMIN_PASSWORD=replace-with-a-long-unique-passphrase
ADMIN_PREFERRED_LANGUAGE=en

NEXT_TELEMETRY_DISABLED=1
